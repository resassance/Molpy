<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true"><domain includeSubdomains="false">127.0.0.1</domain></domain-config>
    <!-- Isolated TLS fixture trust, debug APK only; production keeps platform origin trust. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">unresolved.test.invalid</domain>
        <trust-anchors><certificates src="@raw/proxy_test_ca" /></trust-anchors>
    </domain-config>
</network-security-config>
